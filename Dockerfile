# syntax=docker/dockerfile:1
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* values are compiled into the bundle, so they are build arguments, not runtime settings.
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG BACKEND_URL=http://backend:8000
ARG NEXT_PUBLIC_SIGNUPS_OPEN=0
ARG NEXT_PUBLIC_DESIGNER_ONLY=0
ARG NEXT_PUBLIC_CONTACT_MODE=mailto
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_PRICE_LABEL=
ARG NEXT_PUBLIC_ADSENSE_CLIENT=
ARG NEXT_PUBLIC_ADSENSE_SLOT_DESIGNER=
# Operator details for the imprint / privacy policy (build-time, kept out of the repository):
ARG NEXT_PUBLIC_LEGAL_NAME=
ARG NEXT_PUBLIC_LEGAL_STREET=
ARG NEXT_PUBLIC_LEGAL_CITY=
ARG NEXT_PUBLIC_LEGAL_COUNTRY=
ARG NEXT_PUBLIC_LEGAL_EMAIL=
ARG NEXT_PUBLIC_LEGAL_PHONE=
ARG NEXT_PUBLIC_LEGAL_VAT_ID=
ARG NEXT_PUBLIC_LEGAL_REGISTER=
ARG NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
ARG NEXT_PUBLIC_LEGAL_HOSTING=
ARG NEXT_PUBLIC_LEGAL_EU_REPRESENTATIVE=
ARG NEXT_PUBLIC_LEGAL_DEMO=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL BACKEND_URL=$BACKEND_URL NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_SIGNUPS_OPEN=$NEXT_PUBLIC_SIGNUPS_OPEN NEXT_PUBLIC_DESIGNER_ONLY=$NEXT_PUBLIC_DESIGNER_ONLY \
    NEXT_PUBLIC_CONTACT_MODE=$NEXT_PUBLIC_CONTACT_MODE NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
    NEXT_PUBLIC_PRICE_LABEL=$NEXT_PUBLIC_PRICE_LABEL NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT \
    NEXT_PUBLIC_ADSENSE_SLOT_DESIGNER=$NEXT_PUBLIC_ADSENSE_SLOT_DESIGNER \
    NEXT_PUBLIC_LEGAL_NAME=$NEXT_PUBLIC_LEGAL_NAME \
    NEXT_PUBLIC_LEGAL_STREET=$NEXT_PUBLIC_LEGAL_STREET \
    NEXT_PUBLIC_LEGAL_CITY=$NEXT_PUBLIC_LEGAL_CITY \
    NEXT_PUBLIC_LEGAL_COUNTRY=$NEXT_PUBLIC_LEGAL_COUNTRY \
    NEXT_PUBLIC_LEGAL_EMAIL=$NEXT_PUBLIC_LEGAL_EMAIL \
    NEXT_PUBLIC_LEGAL_PHONE=$NEXT_PUBLIC_LEGAL_PHONE \
    NEXT_PUBLIC_LEGAL_VAT_ID=$NEXT_PUBLIC_LEGAL_VAT_ID \
    NEXT_PUBLIC_LEGAL_REGISTER=$NEXT_PUBLIC_LEGAL_REGISTER \
    NEXT_PUBLIC_LEGAL_REPRESENTATIVE=$NEXT_PUBLIC_LEGAL_REPRESENTATIVE \
    NEXT_PUBLIC_LEGAL_HOSTING=$NEXT_PUBLIC_LEGAL_HOSTING \
    NEXT_PUBLIC_LEGAL_EU_REPRESENTATIVE=$NEXT_PUBLIC_LEGAL_EU_REPRESENTATIVE \
    NEXT_PUBLIC_LEGAL_DEMO=$NEXT_PUBLIC_LEGAL_DEMO
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER app
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1:3000/en >/dev/null || exit 1
CMD ["node", "server.js"]
