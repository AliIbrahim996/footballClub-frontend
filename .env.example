BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECURE=0

# Only for `docker compose --profile with-api` (the API + PostgreSQL). No defaults exist: containers refuse to start without these.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
SEED_DEMO_DATA=0
SEED_ADMIN_PASSWORD=

NEXT_PUBLIC_PRICE_LABEL=€9
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_DESIGNER=
ADSENSE_PUB_ID=
APP_URL=

# --- launch switches (build-time: compiled into the site) ---
NEXT_PUBLIC_SIGNUPS_OPEN=0     # 1 = show sign-up / free trial (also set SIGNUPS_OPEN=1 on the API)
NEXT_PUBLIC_DESIGNER_ONLY=0    # 1 = free hosting mode: public pages + designer only, no backend needed
NEXT_PUBLIC_CONTACT_MODE=mailto  # mailto = no backend; form = send via the API (stored + e-mailed)
NEXT_PUBLIC_CONTACT_EMAIL=     # shown on the contact page in mailto mode

# --- legal pages: who operates the site (REQUIRED before launch: imprint, privacy policy, terms) ---
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_COUNTRY=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_REGISTER=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_LEGAL_HOSTING=
NEXT_PUBLIC_LEGAL_DEMO=1            # 1 = non-commercial personal/portfolio project: no street address needed, imprint says so
NEXT_PUBLIC_LEGAL_EU_REPRESENTATIVE=   # only if you are based outside the EU/EEA (GDPR Art. 27)
# NAME: person or company incl. legal form; STREET + CITY: a postal address where you can be served (no PO box);
# EMAIL: reachable address; PHONE (or a working contact form) for a second quick contact; VAT_ID/REGISTER/REPRESENTATIVE only if they apply;
# HOSTING: your hosting provider(s) as named in the privacy policy
